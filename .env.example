# Não commitar .env.local — só este .env.example vai para o Git.

# URL pública do site (metadata, links absolutos). Em produção use https://
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Link de agendamento WhatsApp (ex.: https://wa.me/5511999999999)
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/5512997776689

# Admin (edição de textos em /admin)
# Na Vercel: Project → Settings → Environment Variables → adicione as duas
# abaixo em Production (e Preview) → Save → Redeploy.
ADMIN_PASSWORD=palmeira2026
ADMIN_SESSION_SECRET=troque-este-segredo-longo-16chars

# Storage persistente (obrigatório na Vercel para o admin salvar textos/fotos).
# Crie em: Vercel → Storage → Create → Blob → Connect to Project
# Isso injeta automaticamente BLOB_READ_WRITE_TOKEN.
BLOB_READ_WRITE_TOKEN=
